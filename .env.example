# Copy this file to .env and put real values there: cp .env.example .env
# .env is gitignored. Never commit real passwords.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=drakon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drakon

# goose (database migrations). goose reads this file when you run it from
# the repo root. Use the same user, password and database as above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://drakon:change-me@localhost:5432/drakon?sslmode=disable
GOOSE_MIGRATION_DIR=api/db/migrations

# Go API (api/). Same user, password and database as above.
# Tests use a separate database, drakon_test, in the same container
# (created automatically). They never touch the drakon database.
DATABASE_URL=postgres://drakon:change-me@localhost:5432/drakon?sslmode=disable
PORT=8080

# Admin login security (api/internal/config).
# COOKIE_SECURE: keep true. Browsers allow Secure cookies on http://localhost.
# Set false ONLY to test from your phone over plain http on your Wi-Fi.
COOKIE_SECURE=true
# Sites allowed to send admin changes (CSRF guard), comma-separated, no
# trailing slash. Dev default: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Filled in by `cd api && make dev-owner` (local only). Leave empty here.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
